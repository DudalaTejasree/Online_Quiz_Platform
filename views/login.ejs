<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Login - Quiz Platform</title>
  <link rel="stylesheet" href="/css/style.css" />
  <style>
    .auth-container {
      max-width: 400px;
      margin: 50px auto;
    }

    .auth-card {
      background: white;
      padding: 40px;
      border-radius: 12px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
    }

    .auth-card h1 {
      font-size: 1.8em;
      margin-bottom: 30px;
    }

    .form-group {
      margin-bottom: 20px;
    }

    .form-group label {
      display: block;
      margin-bottom: 8px;
      font-weight: 600;
      color: #2c3e50;
    }

    .form-group input {
      width: 100%;
      padding: 12px;
      border: 2px solid #e0e0e0;
      border-radius: 6px;
      font-size: 14px;
      transition: all 0.3s ease;
    }

    .form-group input:focus {
      outline: none;
      border-color: #667eea;
      box-shadow: 0 0 8px rgba(102, 126, 234, 0.5);
    }

    .error-message {
      background: linear-gradient(135deg, #fadbd8 0%, #f5b7af 100%);
      color: #e74c3c;
      padding: 12px;
      border-left: 5px solid #e74c3c;
      margin-bottom: 20px;
      border-radius: 6px;
      font-size: 0.9em;
    }

    .submit-btn {
      width: 100%;
      padding: 12px;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      border: none;
      border-radius: 6px;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s ease;
      box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
    }

    .submit-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(102, 126, 234, 0.6);
    }

    .auth-link {
      text-align: center;
      margin-top: 20px;
    }

    .auth-link p {
      color: #7f8c8d;
      margin-bottom: 10px;
    }

    .auth-link a {
      color: #667eea;
      text-decoration: none;
      font-weight: 600;
      transition: all 0.3s ease;
    }

    .auth-link a:hover {
      color: #764ba2;
    }
  </style>
</head>
<body>
  <div class="auth-container">
    <div class="auth-card">
      <h1>🔐 Login</h1>

      <% if (typeof error !== 'undefined' && error) { %>
      <div class="error-message"><%= error %></div>
      <% } %>

      <form method="POST" action="/login">
        <div class="form-group">
          <label for="email">Email Address</label>
          <input
            type="email"
            id="email"
            name="email"
            placeholder="Enter your email"
            required
            autofocus
          />
        </div>

        <div class="form-group">
          <label for="password">Password</label>
          <input
            type="password"
            id="password"
            name="password"
            placeholder="Enter your password"
            required
          />
        </div>

        <button type="submit" class="submit-btn">Sign In</button>
      </form>

      <div class="auth-link">
        <p>Don't have an account?</p>
        <a href="/signup">Create one now →</a>
      </div>
    </div>
  </div>
</body>
</html>
