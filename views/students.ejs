<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Students - Quiz Platform</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <div style="max-width:900px;margin:30px auto;padding:20px;">
    <h1>🔎 Students</h1>

    <form method="GET" action="/students" style="margin-bottom:20px;">
      <input type="text" name="q" placeholder="Search by name or email" style="padding:10px;width:70%;border-radius:6px;border:1px solid #ddd;" />
      <button type="submit" style="padding:10px 14px;border-radius:6px;margin-left:8px;background:#667eea;color:#fff;border:none;">Search</button>
    </form>

    <% if (!students || students.length === 0) { %>
      <p>No students found.</p>
    <% } else { %>
      <table style="width:100%;border-collapse:collapse;">
        <thead>
          <tr style="text-align:left;border-bottom:2px solid #eee;">
            <th style="padding:8px">Name</th>
            <th style="padding:8px">Email</th>
            <th style="padding:8px">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% students.forEach(s => { %>
            <tr>
              <td style="padding:8px"><%= s.fullname %></td>
              <td style="padding:8px"><%= s.email %></td>
              <td style="padding:8px">
                <a href="/students/<%= encodeURIComponent(s.fullname) %>/attempts" class="btn">View Attempts</a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>

    <div style="margin-top:20px;"><a href="/" class="btn btn-secondary">← Back to Home</a></div>
  </div>
</body>
</html>
