<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= quiz.title %> - Attempts</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <div style="max-width:900px;margin:30px auto;padding:20px;">
    <h1>📋 Attempts for: <%= quiz.title %></h1>

    <% if (!attempts || attempts.length === 0) { %>
      <p>No attempts for this quiz yet.</p>
    <% } else { %>
      <table style="width:100%;border-collapse:collapse;">
        <thead>
          <tr style="text-align:left;border-bottom:2px solid #eee;">
            <th style="padding:8px">Student</th>
            <th style="padding:8px">Score</th>
            <th style="padding:8px">Total</th>
            <th style="padding:8px">Date</th>
          </tr>
        </thead>
        <tbody>
          <% attempts.forEach(a => { %>
            <tr>
              <td style="padding:8px"><%= a.username %></td>
              <td style="padding:8px"><%= a.score %></td>
              <td style="padding:8px"><%= a.totalQuestions %></td>
              <td style="padding:8px"><%= new Date(a.createdAt).toLocaleString() %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>

    <div style="margin-top:20px;"><a href="/quizzes" class="btn btn-secondary">← Back to Quizzes</a></div>
  </div>
</body>
</html>
